# Copy to .env (not committed) and export these before starting uvicorn.
# Forex and gold data (free tier available at twelvedata.com):
TWELVEDATA_API_KEY=
# Comma-separated browser origins allowed to call the API:
CORS_ORIGINS=http://localhost:3100
# If api.binance.com is blocked where you host, try the public market-data mirror:
# BINANCE_BASE_URL=https://data-api.binance.vision/api/v3
# WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,EURUSD,GBPUSD,XAUUSD
